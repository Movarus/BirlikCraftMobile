<?xml version="1.0" encoding="utf-8"?>
<!-- Category entry of the pack browser sidebar; "selected" is the active category -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_6sdp" />
            <solid android:color="#33D4A33B" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/birlik_gold_face" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_6sdp" />
            <solid android:color="#1AFFFFFF" />
        </shape>
    </item>
    <item><shape android:shape="rectangle"><solid android:color="@android:color/transparent" /></shape></item>
</selector>
