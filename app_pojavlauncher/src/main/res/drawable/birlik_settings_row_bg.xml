<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row card -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_8sdp" />
            <solid android:color="#F22C2F37" />
            <stroke android:width="@dimen/_1sdp" android:color="@color/birlik_gold_light" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_8sdp" />
            <solid android:color="#CC1E2026" />
            <stroke android:width="@dimen/_1sdp" android:color="#33D4A33B" />
        </shape>
    </item>
</selector>
