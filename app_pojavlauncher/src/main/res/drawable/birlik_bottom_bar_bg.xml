<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom bar: charcoal fading upwards with a thin gold top line -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#F20E0F12"
                android:endColor="#B31A1C21" />
        </shape>
    </item>
    <item android:gravity="top" android:height="@dimen/_1sdp">
        <shape android:shape="rectangle">
            <solid android:color="#99D4A33B" />
        </shape>
    </item>
</layer-list>
