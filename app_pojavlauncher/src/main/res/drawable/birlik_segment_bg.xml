<?xml version="1.0" encoding="utf-8"?>
<!-- One option of the version switch; "selected" is the active version -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_16sdp" />
            <gradient android:angle="270" android:startColor="@color/birlik_gold_light" android:endColor="@color/birlik_gold_face" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_16sdp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
