<?xml version="1.0" encoding="utf-8"?>
<!-- BirlikCraft server launcher home (landscape). The wallpaper and scrim are drawn by
     activity_pojav_launcher; this fragment is transparent on top of them. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/birlik_column_split"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.42" />

    <!-- ============ Left column: server identity ============ -->
    <LinearLayout
        android:id="@+id/birlik_brand_column"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_12sdp"
        app:layout_constraintBottom_toTopOf="@id/birlik_bottom_bar"
        app:layout_constraintEnd_toStartOf="@id/birlik_column_split"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/birlikcraft_hero_logo"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_70sdp"
            android:scaleType="fitCenter"
            android:src="@drawable/birlikcraft_logo"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/birlik_brand_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/minecraft_ten"
            android:letterSpacing="0.06"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="6"
            android:text="@string/birlik_brand_title"
            android:textColor="@color/birlik_gold_light"
            android:textSize="@dimen/_24ssp" />

        <TextView
            android:id="@+id/birlik_brand_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.3"
            android:shadowColor="#CC000000"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="@string/birlik_brand_subtitle"
            android:textColor="#D9FFFFFF"
            android:textSize="@dimen/_8ssp" />

        <!-- Tap to copy the server address -->
        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/server_ip_button"
            style="@style/LauncherMenuButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/birlik_server_chip"
            android:drawableStart="@drawable/ic_menu_home"
            android:text="@string/server_ip"
            android:textColor="@color/birlik_gold_light" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:orientation="horizontal">

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/discord_button"
                style="@style/LauncherMenuButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginEnd="@dimen/_3sdp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_discord"
                android:text="@string/mcl_button_discord" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/news_button"
                style="@style/LauncherMenuButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginStart="@dimen/_3sdp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_menu_news"
                android:text="@string/birlik_menu_website" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Right column: tools ============ -->
    <ScrollView
        android:id="@+id/birlik_tools_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingVertical="@dimen/_6sdp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/birlik_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/birlik_column_split"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="@dimen/_8sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:letterSpacing="0.2"
                android:text="@string/birlik_section_tools"
                android:textColor="@color/birlik_gold_light"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold" />

            <LinearLayout style="@style/BirlikTileRow">
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/resource_packs_button"
                    style="@style/BirlikTile"
                    android:drawableStart="@drawable/ic_menu_resourcepacks"
                    android:text="@string/birlik_menu_resourcepacks" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/shader_packs_button"
                    style="@style/BirlikTile"
                    android:drawableStart="@drawable/ic_menu_shaderpacks"
                    android:text="@string/birlik_menu_shaderpacks" />
            </LinearLayout>

            <LinearLayout style="@style/BirlikTileRow">
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/custom_control_button"
                    style="@style/BirlikTile"
                    android:drawableStart="@drawable/ic_menu_custom_controls"
                    android:text="@string/mcl_option_customcontrol" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/open_files_button"
                    style="@style/BirlikTile"
                    android:drawableStart="@drawable/ic_folder"
                    android:text="@string/mcl_button_open_directory" />
            </LinearLayout>

            <LinearLayout style="@style/BirlikTileRow">
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/share_logs_button"
                    style="@style/BirlikTile"
                    android:drawableStart="@android:drawable/ic_menu_share"
                    android:text="@string/main_share_logs" />
                <!-- Hidden: BirlikCraft versions are fixed -->
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/install_jar_button"
                    style="@style/BirlikTile"
                    android:drawableStart="@drawable/ic_menu_install_jar"
                    android:text="@string/main_install_jar_file"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ============ Bottom bar: version + play ============ -->
    <LinearLayout
        android:id="@+id/birlik_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_52sdp"
        android:background="@drawable/birlik_bottom_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_6sdp"
            android:letterSpacing="0.2"
            android:text="@string/birlik_version_label"
            android:textAllCaps="true"
            android:textColor="@color/birlik_gold_light"
            android:textSize="@dimen/_8ssp"
            android:textStyle="bold" />

        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="0dp"
            android:layout_height="@dimen/_36sdp"
            android:layout_weight="1"
            android:background="@drawable/birlik_version_chip"
            android:drawableEnd="@drawable/spinner_arrow"
            app:drawableEndPadding="@dimen/_1sdp"
            app:drawableEndSize="@dimen/_12sdp"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="@dimen/_30sdp" />

        <!-- Hidden: profiles cannot be edited -->
        <ImageButton
            android:id="@+id/edit_profile_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@null"
            android:src="@drawable/ic_edit_profile"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1.1"
            android:fontFamily="@font/minecraft_ten"
            android:letterSpacing="0.1"
            android:text="@string/main_play"
            android:textAllCaps="true" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
