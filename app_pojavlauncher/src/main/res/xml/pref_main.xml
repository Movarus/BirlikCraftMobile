<?xml version="1.0" encoding="utf-8"?>
<!-- BirlikCraft settings home. Deliberately limited: the game engine is managed by BirlikCraft. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:key="">

    <PreferenceCategory android:title="@string/birlik_pref_category_game">
        <Preference
            android:key="birlik_graphics"
            android:title="@string/birlik_menu_graphics"
            android:summary="@string/birlik_graphics_summary"
            android:icon="@drawable/ic_birlik_graphics" />
        <Preference
            android:key="birlik_edit_controls"
            android:title="@string/birlik_edit_controls_title"
            android:summary="@string/birlik_edit_controls_summary"
            android:icon="@drawable/ic_menu_custom_controls" />
        <Preference
            android:key="control_screen_setting"
            android:title="@string/birlik_touch_settings_title"
            android:summary="@string/birlik_touch_settings_summary"
            android:fragment="net.kdt.pojavlaunch.prefs.screens.LauncherPreferenceControlFragment"
            android:icon="@drawable/ic_setting_gesture_time" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/birlik_pref_category_performance">
        <net.kdt.pojavlaunch.prefs.CustomSeekBarPreference
            android:key="resolutionRatio"
            android:title="@string/mcl_setting_title_resolution_scaler"
            android:summary="@string/mcl_setting_subtitle_resolution_scaler"
            android:icon="@drawable/ic_setting_screen_resolution"
            app:showSeekBarValue="true"
            app:selectable="false"
            app:min="@integer/resolution_seekbar_min"
            app:seekBarIncrement="@integer/resolution_seekbar_increment" />
        <net.kdt.pojavlaunch.prefs.CustomSeekBarPreference
            android:key="allocation"
            android:title="@string/mcl_memory_allocation"
            android:summary="@string/mcl_memory_allocation_subtitle"
            android:icon="@drawable/ic_setting_ram"
            app:showSeekBarValue="true"
            app:selectable="false"
            app:min="@integer/memory_seekbar_min"
            app:seekBarIncrement="@integer/memory_seekbar_increment" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/birlik_pref_category_permissions">
        <Preference
            android:key="notification_permission_request"
            android:title="@string/preference_ask_for_notification_title"
            android:summary="@string/preference_ask_for_notification_description" />
        <Preference
            android:key="microphone_permission_request"
            android:title="@string/preference_ask_for_microphone_title"
            android:summary="@string/preference_ask_for_microphone_description" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/birlik_pref_category_other">
        <Preference
            android:key="birlik_developer_screen"
            android:title="@string/birlik_pref_category_developer"
            android:summary="@string/birlik_developer_summary"
            android:fragment="net.kdt.pojavlaunch.prefs.screens.BirlikDeveloperPreferenceFragment"
            android:icon="@drawable/ic_setting_misc" />
        <Preference
            android:key="birlik_about_screen"
            android:title="@string/pref_category_about"
            android:summary="@string/birlik_about_summary"
            android:fragment="net.kdt.pojavlaunch.prefs.screens.BirlikAboutPreferenceFragment"
            android:icon="@drawable/ic_edit_profile" />
    </PreferenceCategory>
</PreferenceScreen>
