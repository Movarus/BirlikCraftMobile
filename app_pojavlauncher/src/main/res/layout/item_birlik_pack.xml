<?xml version="1.0" encoding="utf-8"?>
<!-- One result card of the BirlikCraft pack browser -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_64sdp"
    android:layout_margin="@dimen/_3sdp"
    android:background="@drawable/birlik_tile_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/_8sdp">

    <ImageView
        android:id="@+id/birlik_pack_icon"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_44sdp"
        android:background="@drawable/birlik_tile_icon_bg"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/birlik_pack_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/birlik_pack_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/birlik_gold_light"
            android:textSize="@dimen/_7ssp" />

        <TextView
            android:id="@+id/birlik_pack_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#B3FFFFFF"
            android:textSize="@dimen/_8ssp" />
    </LinearLayout>
</LinearLayout>
