<?xml version="1.0" encoding="utf-8"?>
<!-- BirlikCraft home page (inside activity_pojav_launcher's container). -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/birlik_home_split"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.46" />

    <!-- ============ Left: welcome + server ============ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/_16sdp"
        android:paddingEnd="@dimen/_10sdp"
        app:layout_constraintBottom_toTopOf="@id/birlik_bottom_bar"
        app:layout_constraintEnd_toStartOf="@id/birlik_home_split"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:shadowColor="#CC000000"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="@string/birlik_home_welcome"
            android:textAllCaps="true"
            android:textColor="#D9FFFFFF"
            android:textSize="@dimen/_9ssp" />

        <TextView
            android:id="@+id/birlik_home_player"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/minecraft_ten"
            android:shadowColor="#E6000000"
            android:shadowDy="4"
            android:shadowRadius="8"
            android:singleLine="true"
            android:textColor="@color/birlik_gold_light"
            android:textSize="@dimen/_26ssp"
            tools:text="Birlik" />

        <!-- Server card: tap to copy the address -->
        <LinearLayout
            android:id="@+id/server_ip_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/birlik_server_card_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_10sdp">

            <ImageView
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:scaleType="fitCenter"
                android:src="@drawable/birlikcraft_logo"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/birlik_server_card_title"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/server_ip"
                    android:textColor="@color/birlik_gold_light"
                    android:textSize="@dimen/_10ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/birlik_server_copy_hint"
                    android:textColor="#99FFFFFF"
                    android:textSize="@dimen/_7ssp" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:alpha="0.8"
                android:src="@drawable/ic_birlik_copy"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/discord_button"
                style="@style/BirlikLinkPill"
                android:layout_marginEnd="@dimen/_4sdp">
                <ImageView style="@style/BirlikLinkPillIcon" android:src="@drawable/ic_discord" tools:ignore="ContentDescription" />
                <TextView style="@style/BirlikLinkPillLabel" android:text="@string/mcl_button_discord" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/news_button"
                style="@style/BirlikLinkPill"
                android:layout_marginStart="@dimen/_4sdp">
                <ImageView style="@style/BirlikLinkPillIcon" android:src="@drawable/ic_birlik_globe" tools:ignore="ContentDescription" />
                <TextView style="@style/BirlikLinkPillLabel" android:text="@string/birlik_menu_website" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Right: content cards ============ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/_6sdp"
        android:paddingEnd="@dimen/_16sdp"
        app:layout_constraintBottom_toTopOf="@id/birlik_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/birlik_home_split"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_2sdp"
            android:letterSpacing="0.2"
            android:text="@string/birlik_section_content"
            android:textColor="@color/birlik_gold_light"
            android:textSize="@dimen/_8ssp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/resource_packs_button"
            style="@style/BirlikContentCard">
            <ImageView
                style="@style/BirlikContentCardIcon"
                android:src="@drawable/ic_menu_resourcepacks"
                tools:ignore="ContentDescription" />
            <LinearLayout style="@style/BirlikContentCardText">
                <TextView style="@style/BirlikContentCardTitle" android:text="@string/birlik_menu_resourcepacks" />
                <TextView style="@style/BirlikContentCardSubtitle" android:text="@string/birlik_resourcepacks_card_summary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shader_packs_button"
            style="@style/BirlikContentCard">
            <ImageView
                style="@style/BirlikContentCardIcon"
                android:src="@drawable/ic_menu_shaderpacks"
                tools:ignore="ContentDescription" />
            <LinearLayout style="@style/BirlikContentCardText">
                <TextView style="@style/BirlikContentCardTitle" android:text="@string/birlik_menu_shaderpacks" />
                <TextView style="@style/BirlikContentCardSubtitle" android:text="@string/birlik_shaderpacks_card_summary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Bottom: version switch + play ============ -->
    <LinearLayout
        android:id="@+id/birlik_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_54sdp"
        android:background="@drawable/birlik_bottom_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_14sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:letterSpacing="0.2"
                android:text="@string/birlik_version_label"
                android:textAllCaps="true"
                android:textColor="@color/birlik_gold_light"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:background="@drawable/birlik_segment_container_bg"
                android:orientation="horizontal"
                android:padding="@dimen/_2sdp">

                <TextView
                    android:id="@+id/birlik_version_263"
                    style="@style/BirlikSegment"
                    android:text="@string/birlik_version_263" />

                <TextView
                    android:id="@+id/birlik_version_262"
                    style="@style/BirlikSegment"
                    android:text="@string/birlik_version_262" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Kept for the launcher logic; versions are switched with the segment above -->
        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="@dimen/_170sdp"
            android:layout_height="@dimen/_42sdp"
            android:drawableStart="@drawable/ic_birlik_play"
            android:drawableTint="#3B1A00"
            android:fontFamily="@font/minecraft_ten"
            android:letterSpacing="0.12"
            android:paddingHorizontal="@dimen/_16sdp"
            android:text="@string/main_play"
            android:textAllCaps="true" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
