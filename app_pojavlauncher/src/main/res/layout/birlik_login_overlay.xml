<?xml version="1.0" encoding="utf-8"?>
<!-- BirlikCraft login screen. Covers the whole launcher until the player logs in (BirlikLoginController). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/birlik_login_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:clickable="true"
    android:elevation="@dimen/_10sdp"
    android:focusable="true"
    android:visibility="gone">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/birlikcraft_bg"
        tools:ignore="ContentDescription" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/birlik_splash_scrim" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/_12sdp">

            <LinearLayout
                android:id="@+id/birlik_login_card"
                android:layout_width="@dimen/_240sdp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/birlik_login_card_bg"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/_14sdp">

                <ImageView
                    android:layout_width="@dimen/_52sdp"
                    android:layout_height="@dimen/_52sdp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/birlikcraft_logo"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:fontFamily="@font/minecraft_ten"
                    android:letterSpacing="0.06"
                    android:shadowColor="#CC000000"
                    android:shadowDy="3"
                    android:shadowRadius="5"
                    android:text="@string/birlik_brand_title"
                    android:textColor="@color/birlik_gold_light"
                    android:textSize="@dimen/_18ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:text="@string/birlik_login_subtitle"
                    android:textColor="#CCFFFFFF"
                    android:textSize="@dimen/_9ssp" />

                <EditText
                    android:id="@+id/birlik_login_username"
                    style="@style/BirlikLoginField"
                    android:autofillHints="username"
                    android:hint="@string/birlik_login_username"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLength="64" />

                <EditText
                    android:id="@+id/birlik_login_password"
                    style="@style/BirlikLoginField"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:autofillHints="password"
                    android:hint="@string/birlik_login_password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLength="128" />

                <TextView
                    android:id="@+id/birlik_login_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:gravity="center"
                    android:textColor="#FF6B6B"
                    android:textSize="@dimen/_9ssp"
                    android:visibility="gone" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_marginTop="@dimen/_10sdp">

                    <com.kdt.mcgui.MineButton
                        android:id="@+id/birlik_login_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/minecraft_ten"
                        android:letterSpacing="0.08"
                        android:text="@string/birlik_login_button"
                        android:textAllCaps="true" />

                    <ProgressBar
                        android:id="@+id/birlik_login_progress"
                        android:layout_width="@dimen/_22sdp"
                        android:layout_height="@dimen/_22sdp"
                        android:layout_gravity="center"
                        android:indeterminateTint="#3B1A00"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/birlik_login_register"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:padding="@dimen/_4sdp"
                    android:text="@string/birlik_login_register"
                    android:textColor="@color/birlik_gold_light"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>
