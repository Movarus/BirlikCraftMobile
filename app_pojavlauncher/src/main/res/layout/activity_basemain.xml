<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_height="match_parent"
	android:layout_width="match_parent"
	android:layout_alignParentRight="true"
	android:id="@+id/main_drawer_options"
	android:background="@drawable/no_focus_shown"
	android:keepScreenOn="true">

	<FrameLayout
		android:id="@+id/content_frame"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<net.kdt.pojavlaunch.customcontrols.ControlLayout
			android:id="@+id/main_control_layout"
			android:layout_width="match_parent"
			android:layout_height="match_parent">

			<View style="@style/DimensionTracker"/>

			<net.kdt.pojavlaunch.MinecraftGLSurface
				android:id="@+id/main_game_render_view"
				android:layout_width="fill_parent"
				android:layout_height="fill_parent"
				android:defaultFocusHighlightEnabled="false"
                tools:ignore="UnusedAttribute" />

			<net.kdt.pojavlaunch.customcontrols.mouse.Touchpad
				android:layout_height="match_parent"
				android:layout_width="match_parent"
				android:orientation="vertical"
				android:id="@+id/main_touchpad"
				android:focusable="false"
				android:translationZ="1dp"
				android:visibility="gone"/>


			<net.kdt.pojavlaunch.customcontrols.keyboard.TouchCharInput
				android:id="@+id/mainTouchCharInput"
				android:layout_width="1dp"
				android:layout_height="1dp"
				android:background="@android:color/darker_gray"
				android:ems="10"
				android:imeOptions="flagNoFullscreen|flagNoExtractUi|flagNoPersonalizedLearning|actionDone"
				android:inputType="textFilter|textImeMultiLine|textAutoComplete|textAutoCorrect"
				tools:ignore="TouchTargetSizeCheck" />

			<net.kdt.pojavlaunch.customcontrols.handleview.DrawerPullButton
				android:id="@+id/drawer_button"
				android:layout_width="40dp"
				android:layout_height="20dp"
				android:padding="8dp"
				android:elevation="10dp"
				android:layout_gravity="center_horizontal"/>
			<net.kdt.pojavlaunch.customcontrols.mouse.HotbarView
				android:id="@+id/hotbar_view"
				android:layout_width="0px"
				android:layout_height="0px"/>

		</net.kdt.pojavlaunch.customcontrols.ControlLayout>

		<com.kdt.LoggerView
			android:id="@+id/mainLoggerView"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone"
			/>

		<!-- BirlikCraft Custom Cinematic Startup / Splash Overlay -->
		<FrameLayout
			android:id="@+id/birlik_splash_overlay"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="#0D0E15"
			android:clickable="true"
			android:focusable="true">

			<ImageView
				android:id="@+id/birlik_splash_static_bg"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:scaleType="centerCrop"
				android:src="@drawable/birlik_splash_bg"
				android:alpha="1.0"
				tools:ignore="ContentDescription" />

			<VideoView
				android:id="@+id/birlik_splash_video"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:layout_gravity="center"
				android:visibility="gone" />

			<View
				android:id="@+id/birlik_splash_tint"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="#33000000" />

			<LinearLayout
				android:id="@+id/birlik_splash_content"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center"
				android:gravity="center"
				android:orientation="vertical">

				<ImageView
					android:layout_width="@dimen/_180sdp"
					android:layout_height="@dimen/_70sdp"
					android:scaleType="fitCenter"
					android:src="@drawable/birlikcraft_logo"
					tools:ignore="ContentDescription" />

				<ProgressBar
					android:layout_width="@dimen/_28sdp"
					android:layout_height="@dimen/_28sdp"
					android:layout_marginTop="@dimen/_14sdp"
					android:indeterminateTint="@color/birlik_gold_face" />

				<TextView
					android:id="@+id/birlik_splash_status"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/_8sdp"
					android:fontFamily="sans-serif-medium"
					android:text="BirlikCraft Başlatılıyor..."
					android:textColor="@color/birlik_gold_face"
					android:textSize="@dimen/_11ssp"
					android:shadowColor="#000000"
					android:shadowDx="0"
					android:shadowDy="2"
					android:shadowRadius="4" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/_3sdp"
					android:fontFamily="sans-serif"
					android:text="@string/server_ip"
					android:textColor="#B3FFFFFF"
					android:textSize="@dimen/_9ssp" />
			</LinearLayout>

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="bottom|center_horizontal"
				android:layout_marginBottom="@dimen/_10sdp"
				android:text="@string/author_name"
				android:textColor="#80FFFFFF"
				android:textSize="@dimen/_8ssp" />
		</FrameLayout>

		<!-- BirlikCraft Custom Lunar-Style Main Menu Overlay -->
		<FrameLayout
			android:id="@+id/birlik_lunar_overlay"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone"
			android:background="#59000000">

			<!-- Top Bar: Account info pill on left, Controls on right -->
			<RelativeLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingStart="@dimen/_14sdp"
				android:paddingEnd="@dimen/_14sdp"
				android:paddingTop="@dimen/_10sdp">

				<!-- Account Pill: [Avatar] Movarus -->
				<LinearLayout
					android:id="@+id/birlik_account_pill"
					android:layout_width="wrap_content"
					android:layout_height="@dimen/_24sdp"
					android:layout_alignParentStart="true"
					android:background="@drawable/birlik_pill_bg"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="@dimen/_6sdp"
					android:paddingEnd="@dimen/_8sdp">

					<ImageView
						android:id="@+id/birlik_account_avatar"
						android:layout_width="@dimen/_16sdp"
						android:layout_height="@dimen/_16sdp"
						android:src="@drawable/ic_custom_button"
						tools:ignore="ContentDescription" />

					<TextView
						android:id="@+id/birlik_account_name"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="@dimen/_5sdp"
						android:fontFamily="sans-serif-medium"
						android:text="Movarus"
						android:textColor="#FFFFFF"
						android:textSize="@dimen/_10ssp" />
				</LinearLayout>

				<!-- Top-Right: Settings & Exit -->
				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="@dimen/_24sdp"
					android:layout_alignParentEnd="true"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<ImageView
						android:id="@+id/birlik_btn_settings"
						android:layout_width="@dimen/_24sdp"
						android:layout_height="@dimen/_24sdp"
						android:background="@drawable/birlik_circle_button"
						android:padding="@dimen/_5sdp"
						android:src="@drawable/ic_settings"
						tools:ignore="ContentDescription" />

					<ImageView
						android:id="@+id/birlik_btn_quit"
						android:layout_width="@dimen/_24sdp"
						android:layout_height="@dimen/_24sdp"
						android:layout_marginStart="@dimen/_6sdp"
						android:background="@drawable/birlik_circle_button"
						android:padding="@dimen/_5sdp"
						android:src="@drawable/ic_clear_dark"
						tools:ignore="ContentDescription" />
				</LinearLayout>
			</RelativeLayout>

			<!-- Center Column: Logo + BirlikCraft text + Mobile Edition + OYNA + Discord/Store + Banner -->
			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center"
				android:gravity="center_horizontal"
				android:orientation="vertical">

				<!-- Logo -->
				<ImageView
					android:layout_width="@dimen/_44sdp"
					android:layout_height="@dimen/_44sdp"
					android:src="@drawable/birlikcraft_logo"
					tools:ignore="ContentDescription" />

				<!-- Clean modern BIRLIKCRAFT text -->
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/_3sdp"
					android:fontFamily="sans-serif-black"
					android:letterSpacing="0.12"
					android:text="B I R L I K C R A F T"
					android:textColor="#FFFFFF"
					android:textSize="@dimen/_14ssp"
					android:shadowColor="#80000000"
					android:shadowDx="0"
					android:shadowDy="2"
					android:shadowRadius="4" />

				<!-- MOBILE EDITION pill badge -->
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/_2sdp"
					android:background="@drawable/birlik_gold_pill_bg"
					android:fontFamily="sans-serif-medium"
					android:letterSpacing="0.1"
					android:paddingStart="@dimen/_7sdp"
					android:paddingTop="@dimen/_1sdp"
					android:paddingEnd="@dimen/_7sdp"
					android:paddingBottom="@dimen/_1sdp"
					android:text="MOBILE EDITION"
					android:textColor="#F5C754"
					android:textSize="@dimen/_7ssp" />

				<!-- Main Play Button: OYNA (Direct connect to oyna.birlikcraft.com) -->
				<LinearLayout
					android:id="@+id/birlik_btn_play"
					android:layout_width="@dimen/_190sdp"
					android:layout_height="@dimen/_28sdp"
					android:layout_marginTop="@dimen/_10sdp"
					android:background="@drawable/birlik_button_play_bg"
					android:clickable="true"
					android:focusable="true"
					android:gravity="center"
					android:orientation="horizontal">

					<ImageView
						android:layout_width="@dimen/_12sdp"
						android:layout_height="@dimen/_12sdp"
						android:src="@drawable/ic_menu_forward"
						app:tint="#F5C754"
						tools:ignore="ContentDescription" />

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="@dimen/_5sdp"
						android:fontFamily="sans-serif-bold"
						android:letterSpacing="0.05"
						android:text="OYNA  (oyna.birlikcraft.com)"
						android:textColor="#FFFFFF"
						android:textSize="@dimen/_10ssp" />
				</LinearLayout>

				<!-- Secondary Row: Discord + Magaza -->
				<LinearLayout
					android:layout_width="@dimen/_190sdp"
					android:layout_height="@dimen/_24sdp"
					android:layout_marginTop="@dimen/_5sdp"
					android:orientation="horizontal">

					<!-- Discord Button -->
					<LinearLayout
						android:id="@+id/birlik_btn_discord"
						android:layout_width="0dp"
						android:layout_height="match_parent"
						android:layout_weight="1"
						android:layout_marginEnd="@dimen/_3sdp"
						android:background="@drawable/birlik_button_secondary_bg"
						android:clickable="true"
						android:focusable="true"
						android:gravity="center"
						android:orientation="horizontal">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:fontFamily="sans-serif-medium"
							android:text="Discord"
							android:textColor="#8EA1E1"
							android:textSize="@dimen/_9ssp" />
					</LinearLayout>

					<!-- Magaza Button -->
					<LinearLayout
						android:id="@+id/birlik_btn_store"
						android:layout_width="0dp"
						android:layout_height="match_parent"
						android:layout_weight="1"
						android:layout_marginStart="@dimen/_3sdp"
						android:background="@drawable/birlik_button_secondary_bg"
						android:clickable="true"
						android:focusable="true"
						android:gravity="center"
						android:orientation="horizontal">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:fontFamily="sans-serif-medium"
							android:text="Mağaza"
							android:textColor="#57F287"
							android:textSize="@dimen/_9ssp" />
					</LinearLayout>
				</LinearLayout>

				<!-- Bottom Banner: Link your Discord / Katilin -->
				<LinearLayout
					android:id="@+id/birlik_discord_banner"
					android:layout_width="@dimen/_190sdp"
					android:layout_height="@dimen/_28sdp"
					android:layout_marginTop="@dimen/_7sdp"
					android:background="@drawable/birlik_banner_bg"
					android:clickable="true"
					android:focusable="true"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="@dimen/_8sdp"
					android:paddingEnd="@dimen/_8sdp">

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:fontFamily="sans-serif-bold"
							android:text="DISCORD SUNUCUMUZA KATILIN"
							android:textColor="#FFFFFF"
							android:textSize="@dimen/_7ssp" />

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="Özel ödüller ve duyurular için tıkla"
							android:textColor="#B3FFFFFF"
							android:textSize="@dimen/_6ssp" />
					</LinearLayout>

					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="@drawable/birlik_tag_bg"
						android:paddingStart="@dimen/_4sdp"
						android:paddingTop="@dimen/_1sdp"
						android:paddingEnd="@dimen/_4sdp"
						android:paddingBottom="@dimen/_1sdp"
						android:text="ÜCRETSİZ"
						android:textColor="#FFE600"
						android:textSize="@dimen/_6ssp" />
				</LinearLayout>

			</LinearLayout>

		</FrameLayout>

	</FrameLayout>

	<ListView
		android:layout_width="200dp"
		android:layout_height="match_parent"
		android:layout_gravity="right"
		android:background="?attr/colorBackgroundFloating"
		android:fitsSystemWindows="false"
		android:id="@+id/main_navigation_view"/>

</androidx.drawerlayout.widget.DrawerLayout>

